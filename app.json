{
  "expo": {
    "name": "Pupu",
    "slug": "pupu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pupu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.minhthang.pupu",
      "infoPlist": {
        "_comment": "YES lets iOS derive the status bar style from the view controller's trait collection, so it follows light/dark with no JS. It is incompatible with expo-status-bar's imperative API, which is therefore not used.",
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.minhthang.pupu",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-pupu.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1ED",
          "dark": {
            "backgroundColor": "#0C0B0A"
          }
        }
      ],
      [
        "expo-localization",
        {
          "_comment": "Declares the app's own localizations. On iOS this writes CFBundleLocalizations, which is what makes iOS treat the app as Vietnamese-capable and list it under Settings > Pupu > Language; on Android it writes the locales_config used by per-app language settings. Without it the OS has no way to know this app speaks anything but English.",
          "supportedLocales": {
            "ios": ["en", "vi"],
            "android": ["en", "vi"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
