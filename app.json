{
  "expo": {
    "name": "Oneplan",
    "slug": "oneplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "oneplan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oneplan.app",
      "infoPlist": {
        "_comment": "YES lets iOS derive the status bar style from the view controller's trait collection, so it follows light/dark with no JS. It is incompatible with expo-status-bar's imperative API, which is therefore not used.",
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oneplan.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-pip.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1ED",
          "dark": { "backgroundColor": "#0C0B0A" }
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
